{
	"compilerOptions": {
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"target": "ES2024",
		"jsx": "react-jsx",
		"strictNullChecks": true,
		"strictFunctionTypes": true,
		"strict": true,
		"sourceMap": true,
		"typeRoots": ["src/types", "node_modules/types"]
	},
	"exclude": ["node_modules", "**/node_modules/*"]
}
